{
    
  "build": {
    "appId": "com.bidyanand.musicplayer",
    "productName": "BS Music",
    "files": [
      "**/*",
      "!music.db",
      "!covers/**"
    ],
    "win": {
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "deleteAppDataOnUninstall": true
    },
    "publish":{
        "provider":"github",
        "owner":"Bidyanand-sah",
        "repo":"music-player",
        "releaseType":"release"
    }
  },
  "dependencies": {
    "better-sqlite3": "^13.0.1",
    "cors": "^2.8.6",
    "electron-updater": "^6.8.9",
    "express": "^5.2.1",
    "multer": "^2.2.0",
    "music-metadata": "^11.14.0",
    "mysql2": "^3.22.6"
  },
  "name": "bs-music",
  "version": "1.0.2",
  "description": "",
  "main": "main.js",
  "devDependencies": {
    "@electron/rebuild": "^4.2.0",
    "electron": "^43.1.1",
    "electron-builder": "^26.15.3"
  },
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "rebuild": "electron-rebuild",
    "start": "electron .",
    "build": "electron-builder",
    "deploy":"electron-builder --publish always"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "allowScripts": {
    "better-sqlite3@13.0.1": true,
    "electron-winstaller@5.4.0": true
  }
}
